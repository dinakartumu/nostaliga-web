---
import Layout from "../layouts/Layout.astro";
import NotifyForm from "../components/NotifyForm.astro";

// Feature screenshots live in public/screenshots/ (generated from fixture mode).
const memories = [
  {
    img: "/screenshots/now-playing.jpg",
    eyebrow: "Music",
    title: "Your soundtrack, remembered.",
    body: "Every track you played — when, where, and how many times. The score to your life, back on the timeline.",
  },
  {
    img: "/screenshots/photos.jpg",
    eyebrow: "Photos",
    title: "The photos you forgot you took.",
    body: "Your camera roll, matched on-device to the moment and the music that was playing.",
  },
  {
    img: "/screenshots/activity.jpg",
    eyebrow: "Activities",
    title: "Every mile has a soundtrack.",
    body: "Rides, runs and hikes drawn on the map — with the songs that carried you through them.",
  },
  {
    img: "/screenshots/places.jpg",
    eyebrow: "Places",
    title: "The places you kept going back to.",
    body: "Check-ins remember the coffee shops, libraries and streets that quietly became yours.",
  },
  {
    img: "/screenshots/social.jpg",
    eyebrow: "Posts",
    title: "The posts you forgot you wrote.",
    body: "Old tweets and captions, back in the moment they came from — not buried forty thousand posts deep in an archive.",
  },
];

const life = [
  {
    img: "/screenshots/calendar.jpg",
    eyebrow: "Calendar",
    title: "The plans you actually kept.",
    body: "Dinners, reservations and events — who was invited, and who actually showed up.",
  },
  {
    img: "/screenshots/tv.jpg",
    eyebrow: "Movies & TV",
    title: "Every finale. Every letdown.",
    body: "What you watched, the night you finished it, and the tweet you fired off about the ending.",
  },
];
---

<Layout title="Nostaliga — a timeline of everything you've done" path="/" wide>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 -top-40 mx-auto h-[36rem] max-w-3xl rounded-full opacity-40 blur-3xl"
      style="background: radial-gradient(closest-side, rgba(224,184,88,0.35), transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto max-w-6xl px-6 pt-16 pb-8 text-center sm:pt-24">
      <p
        class="mb-6 text-xs uppercase tracking-[0.28em] text-[color:var(--color-ink-dim)]"
      >
        Coming soon to iPhone
      </p>
      <h1
        class="mx-auto max-w-4xl text-5xl leading-[1.05] sm:text-7xl md:text-[5.5rem]"
        style="font-family: var(--font-display);"
      >
        Memories of song.
      </h1>
      <p
        class="mx-auto mt-8 max-w-2xl text-lg text-[color:var(--color-ink-dim)] sm:text-xl"
      >
        Nostaliga starts with every song you've ever played and rebuilds your
        life around it — the photos, workouts, places and posts from each
        moment, on one timeline that never leaves your phone.
      </p>
      <div class="mt-10 flex flex-col items-center gap-5">
        <NotifyForm id="notify-hero" />
        <button
          type="button"
          data-how-open
          class="cursor-pointer rounded-full border border-white/15 px-7 py-3 text-sm text-[color:var(--color-ink)] hover:border-white/40"
        >
          How it works
        </button>
      </div>
    </div>

    <div class="mx-auto mt-6 flex max-w-6xl justify-center px-6 pb-8">
      <img
        src="/screenshots/photos.jpg"
        alt="The Nostaliga now-playing timeline showing a memory from years past"
        width="300"
        loading="eager"
        class="w-[260px] rounded-[2.4rem] border border-white/10 shadow-[0_40px_120px_-20px_rgba(0,0,0,0.8)] sm:w-[300px]"
      />
    </div>
  </section>

  <!-- Statement -->
  <section class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2
        class="text-3xl leading-tight sm:text-5xl"
        style="font-family: var(--font-display);"
      >
        You already made the memories.
        <span class="text-[color:var(--color-ink-dim)]"
          >Nostaliga just brings them back.</span
        >
      </h2>
    </div>
  </section>

  <!-- How it works modal — opened from the hero button -->
  <dialog
    id="how-it-works-modal"
    aria-labelledby="how-it-works-title"
    class="m-auto w-[min(38rem,92vw)] rounded-[28px] border border-white/10 bg-[color:var(--color-bg-soft)] p-0 text-[color:var(--color-ink)] backdrop:bg-black/75 backdrop:backdrop-blur-md"
  >
    <div class="relative flex max-h-[86vh] flex-col">
      <button
        type="button"
        data-how-close
        aria-label="Close"
        class="absolute right-5 top-5 z-10 grid h-9 w-9 cursor-pointer place-items-center rounded-full bg-white/10 text-[color:var(--color-ink)] hover:bg-white/20"
      >
        <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
      </button>

      <div class="overflow-y-auto px-7 py-8 sm:px-9">
        <p class="text-xs uppercase tracking-[0.28em] text-[color:var(--color-accent)]">
          How it works
        </p>
        <h2
          id="how-it-works-title"
          class="mt-3 max-w-sm text-2xl leading-tight sm:text-3xl"
          style="font-family: var(--font-display);"
        >
          A song is the way in.
        </h2>

        <p class="mt-5 text-[color:var(--color-ink-dim)]">
          Nostaliga starts from the song you're playing right now — or any track
          you tap in your history — and works outward from there.
        </p>

        <ol class="mt-7 space-y-6">
          <li class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-sm font-medium text-[color:var(--color-accent)]">01</span>
            <div>
              <h3 class="text-base text-[color:var(--color-ink)]">
                It looks up that song's play history
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[color:var(--color-ink-dim)]">
                Every previous time you played this exact track, going back as far
                as your listening history goes — Apple Music, Spotify or Last.fm.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-sm font-medium text-[color:var(--color-accent)]">02</span>
            <div>
              <h3 class="text-base text-[color:var(--color-ink)]">
                It takes the days those plays landed on
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[color:var(--color-ink-dim)]">
                A Thursday in November 2014. A morning last spring. Whenever this
                song was actually in your ears.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="mt-0.5 shrink-0 text-sm font-medium text-[color:var(--color-accent)]">03</span>
            <div>
              <h3 class="text-base text-[color:var(--color-ink)]">
                Then it rebuilds those days around it
              </h3>
              <p class="mt-1.5 text-sm leading-relaxed text-[color:var(--color-ink-dim)]">
                The photos you took, the run you went on, the places you checked
                into, the episode you finished, what you posted, what was on your
                calendar — laid out hour by hour, under the song.
              </p>
            </div>
          </li>
        </ol>

        <p class="mt-7 border-t border-white/10 pt-6 text-[color:var(--color-ink-dim)]">
          So the timeline under a song isn't a playlist. It's the days that song
          was the soundtrack to, with everything that happened on them.
        </p>

        <p class="mt-5 text-sm leading-relaxed text-[color:var(--color-ink-dim)]">
          You connect your accounts once — listening, plus Photos, Strava, Swarm,
          Trakt and your Twitter, Instagram and Facebook archives — and every bit
          of that matching happens on your phone. Nothing is uploaded.
        </p>
      </div>
    </div>
  </dialog>

  <!-- Band 1: Everything you did -->
  <section class="border-t border-white/5 pt-12">
    <div class="mx-auto max-w-6xl px-6">
      <p
        class="text-xs uppercase tracking-[0.28em] text-[color:var(--color-accent)]"
      >
        Everything you did
      </p>
    </div>
    {
      memories.map((f, i) => (
        <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
          <div
            class:list={[
              "grid items-center gap-10 md:grid-cols-2 md:gap-16",
              i % 2 === 1 && "md:[&>figure]:order-first",
            ]}
          >
            <div>
              <p class="text-sm uppercase tracking-[0.2em] text-[color:var(--color-ink-dim)]">
                {f.eyebrow}
              </p>
              <h3
                class="mt-3 text-3xl leading-tight sm:text-4xl"
                style="font-family: var(--font-display);"
              >
                {f.title}
              </h3>
              <p class="mt-5 max-w-md text-lg text-[color:var(--color-ink-dim)]">
                {f.body}
              </p>
            </div>
            <figure class="relative flex justify-center">
              <div
                class="pointer-events-none absolute inset-x-0 top-1/2 -z-10 mx-auto h-72 w-72 -translate-y-1/2 rounded-full opacity-70 blur-[90px]"
                style="background: radial-gradient(closest-side, rgba(224,184,88,0.16), transparent 72%);"
                aria-hidden="true"
              >
              </div>
              <img
                src={f.img}
                alt={f.title}
                width="280"
                loading="lazy"
                class="relative w-[230px] rounded-[2.2rem] border border-white/10 shadow-[0_30px_90px_-25px_rgba(0,0,0,0.8)] sm:w-[270px]"
              />
            </figure>
          </div>
        </div>
      ))
    }
  </section>

  <!-- Band 2: Everything you loved -->
  <section class="border-t border-white/5 pt-16">
    <div class="mx-auto max-w-6xl px-6">
      <p
        class="text-xs uppercase tracking-[0.28em] text-[color:var(--color-accent)]"
      >
        Everything you loved
      </p>
    </div>
    {
      life.map((f, i) => (
        <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24">
          <div
            class:list={[
              "grid items-center gap-10 md:grid-cols-2 md:gap-16",
              i % 2 === 1 && "md:[&>figure]:order-first",
            ]}
          >
            <div>
              <p class="text-sm uppercase tracking-[0.2em] text-[color:var(--color-ink-dim)]">
                {f.eyebrow}
              </p>
              <h3
                class="mt-3 text-3xl leading-tight sm:text-4xl"
                style="font-family: var(--font-display);"
              >
                {f.title}
              </h3>
              <p class="mt-5 max-w-md text-lg text-[color:var(--color-ink-dim)]">
                {f.body}
              </p>
            </div>
            <figure class="relative flex justify-center">
              <div
                class="pointer-events-none absolute inset-x-0 top-1/2 -z-10 mx-auto h-72 w-72 -translate-y-1/2 rounded-full opacity-70 blur-[90px]"
                style="background: radial-gradient(closest-side, rgba(224,184,88,0.16), transparent 72%);"
                aria-hidden="true"
              >
              </div>
              <img
                src={f.img}
                alt={f.title}
                width="280"
                loading="lazy"
                class="relative w-[230px] rounded-[2.2rem] border border-white/10 shadow-[0_30px_90px_-25px_rgba(0,0,0,0.8)] sm:w-[270px]"
              />
            </figure>
          </div>
        </div>
      ))
    }
  </section>

  <!-- Privacy -->
  <section class="border-t border-white/5 py-24">
    <div class="mx-auto max-w-4xl px-6">
      <h2 class="text-3xl sm:text-5xl" style="font-family: var(--font-display);">
        Private by design.
      </h2>
      <p class="mt-5 max-w-2xl text-lg text-[color:var(--color-ink-dim)]">
        Your whole life is on this timeline — so none of it leaves your phone.
      </p>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/5 bg-[color:var(--color-bg-soft)] p-6">
          <h3 class="text-lg text-[color:var(--color-ink)]">On-device matching</h3>
          <p class="mt-2 text-[color:var(--color-ink-dim)]">
            Photos, music and health data are correlated locally — never uploaded.
          </p>
        </div>
        <div class="rounded-2xl border border-white/5 bg-[color:var(--color-bg-soft)] p-6">
          <h3 class="text-lg text-[color:var(--color-ink)]">Keychain-only tokens</h3>
          <p class="mt-2 text-[color:var(--color-ink-dim)]">
            Every third-party OAuth token stays in the iOS Keychain on your device.
          </p>
        </div>
        <div class="rounded-2xl border border-white/5 bg-[color:var(--color-bg-soft)] p-6">
          <h3 class="text-lg text-[color:var(--color-ink)]">No tracking</h3>
          <p class="mt-2 text-[color:var(--color-ink-dim)]">
            No analytics SDKs, no advertising identifier, no third-party trackers.
          </p>
        </div>
        <div class="rounded-2xl border border-white/5 bg-[color:var(--color-bg-soft)] p-6">
          <h3 class="text-lg text-[color:var(--color-ink)]">You're in control</h3>
          <p class="mt-2 text-[color:var(--color-ink-dim)]">
            Disconnect any service or delete its imported history anytime.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-white/5 py-28">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2
        class="text-4xl leading-tight sm:text-6xl"
        style="font-family: var(--font-display);"
      >
        Relive it all.
      </h2>
      <div class="mt-10">
        <NotifyForm
          id="notify-closing"
          label="Get an email the day it lands on the App Store."
        />
      </div>
    </div>
  </section>

  <script is:inline>
    // Notify form: POST the email to the same-origin function and report back
    // in place. Every form on the page is wired independently.
    (() => {
      document.querySelectorAll("[data-notify-form]").forEach((form) => {
        const status = form.querySelector("[data-notify-status]");
        const submit = form.querySelector("[data-notify-submit]");
        const field = form.querySelector('input[name="email"]');

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          const email = (field?.value || "").trim();
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
            status.textContent = "Enter a valid email address.";
            field?.focus();
            return;
          }

          submit.disabled = true;
          status.textContent = "Adding you…";

          try {
            const response = await fetch("/api/notify", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                email,
                company: form.querySelector('input[name="company"]')?.value || "",
              }),
            });

            if (response.ok) {
              // Replace the whole form so there's nothing left to resubmit.
              form.innerHTML =
                '<p class="text-sm text-[color:var(--color-ink)]">' +
                "You're on the list. We'll email you when Nostaliga launches." +
                "</p>";
              return;
            }

            const data = await response.json().catch(() => ({}));
            status.textContent = data.error || "Something went wrong. Try again?";
            submit.disabled = false;
          } catch {
            status.textContent = "Network error. Try again?";
            submit.disabled = false;
          }
        });
      });
    })();

    (() => {
      const modal = document.getElementById("how-it-works-modal");
      if (!modal) return;

      document.querySelectorAll("[data-how-open]").forEach((btn) =>
        btn.addEventListener("click", () => modal.showModal()),
      );
      modal.querySelectorAll("[data-how-close]").forEach((btn) =>
        btn.addEventListener("click", () => modal.close()),
      );
      // Click outside the card (the dialog element itself is the backdrop area).
      modal.addEventListener("click", (e) => {
        if (e.target === modal) modal.close();
      });
    })();
  </script>
</Layout>
